PORT=5000
NODE_ENV=production
CLIENT_URL=https://acebeautybraids.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/acebeautybraids?retryWrites=true&w=majority
JWT_SECRET=your_super_strong_production_jwt_secret_key_here
# Required only when provisioning the first admin; remove the password after seeding.
# Use at least 15 characters and at most 72 UTF-8 bytes. No default password exists.
ADMIN_SEED_EMAIL=admin@acebeautybraids.com
ADMIN_SEED_PASSWORD=

# Transactional email: Gmail / Google Workspace App Password (2-Step Verification)
# 587 requires STARTTLS; 465 uses TLS immediately. Host and port have these defaults.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# false keeps card-only checkout. true uses payment methods enabled in Stripe.
# Delayed methods are confirmed only after async_payment_succeeded.
STRIPE_DYNAMIC_PAYMENT_METHODS=false

# Manual Bank Transfer
BANK_NAME=Your Bank Name
BANK_ACCOUNT_NAME=AceBeautyBraids
BANK_ACCOUNT_NUMBER=00000000
BANK_SORT_CODE=00-00-00
BANK_IBAN=
BANK_BIC=
BANK_TRANSFER_WINDOW_MINUTES=30

# Cloudinary Media Storage (Images & Videos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
